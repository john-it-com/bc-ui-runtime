{
    "name": "john-it-com/bc-ui-runtime",
    "description": "Runtime bootstrap and module registry for BlueCloud frontend modules.",
    "keywords": [
        "laravel",
        "runtime",
        "inertia",
        "vue"
    ],
    "license": "proprietary",
    "authors": [
        {
            "name": "JOHN IT GmbH",
            "email": "info@john-it.com",
            "homepage": "https://john-it.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "JohnIt\\Bc\\Runtime\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JohnIt\\Bc\\Runtime\\Tests\\": "tests"
        }
    },
    "extra": {
        "documentation": {
            "purpose": "Describe the bc-ui-runtime package metadata, package-local quality tooling, test harness, and dependency requirements.",
            "role": "Defines Composer autoloading, package-local Pest execution, package-local PHPStan analysis, and dependency requirements for the bc-ui-runtime module."
        },
        "laravel": {
            "providers": [
                "JohnIt\\Bc\\Runtime\\PackageServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.40"
    },
    "scripts": {
        "test": "@php vendor/bin/testbench package:test --parallel --testsuite=Package",
        "test:parallel": "@php vendor/bin/testbench package:test --parallel --testsuite=Package --no-coverage",
        "analyse": "vendor/bin/phpstan analyse",
        "discover": "@php vendor/bin/testbench package:discover --ansi"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        },
        "policy": {
            "advisories": {
                "block": false
            }
        },
        "platform": {
            "php": "8.5.0"
        }
    },
    "require-dev": {
        "larastan/larastan": "^3.9.2",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^4.6.2",
        "pestphp/pest-plugin-laravel": "^4.1.0",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan": "^2.1.40",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "conflict": {
        "symfony/clock": ">=8.0",
        "symfony/console": ">=8.0",
        "symfony/css-selector": ">=8.0",
        "symfony/error-handler": ">=8.0",
        "symfony/event-dispatcher": ">=8.0",
        "symfony/finder": ">=8.0",
        "symfony/http-foundation": ">=8.0",
        "symfony/http-kernel": ">=8.0",
        "symfony/mailer": ">=8.0",
        "symfony/mime": ">=8.0",
        "symfony/process": ">=8.0",
        "symfony/routing": ">=8.0",
        "symfony/string": ">=8.0",
        "symfony/translation": ">=8.0",
        "symfony/uid": ">=8.0",
        "symfony/var-dumper": ">=8.0",
        "symfony/yaml": ">=8.0",
        "guzzlehttp/guzzle": ">=8.0",
        "guzzlehttp/promises": ">=3.0",
        "guzzlehttp/psr7": ">=3.0",
        "guzzlehttp/uri-template": ">=2.0"
    }
}
