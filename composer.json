{
    "name": "john-it-com/bc-ui-runtime",
    "description": "Runtime bootstrap and module registry for BlueCloud frontend modules.",
    "keywords": [
        "laravel",
        "runtime",
        "inertia",
        "vue"
    ],
    "license": "proprietary",
    "authors": [
        {
            "name": "JOHN IT GmbH",
            "email": "info@john-it.com",
            "homepage": "https://john-it.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "JohnIt\\Bc\\Runtime\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JohnIt\\Bc\\Runtime\\Tests\\": "tests"
        }
    },
    "extra": {
        "documentation": {
            "purpose": "Describe the bc-ui-runtime package metadata, package-local quality tooling, test harness, and dependency requirements.",
            "role": "Defines Composer autoloading, package-local Pest execution, package-local PHPStan analysis, and dependency requirements for the bc-ui-runtime module."
        },
        "laravel": {
            "providers": [
                "JohnIt\\Bc\\Runtime\\PackageServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.3",
        "laravel/framework": "^11.18"
    },
    "scripts": {
        "post-autoload-dump": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "test": "vendor/bin/pest",
        "test:parallel": "vendor/bin/pest --parallel --processes=4 --no-coverage",
        "test:parallel:coverage": "vendor/bin/pest --parallel --processes=4 --coverage-text",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "require-dev": {
        "larastan/larastan": "^3.9.2",
        "orchestra/testbench": "^9.0.0",
        "pestphp/pest": "^4.6.2",
        "pestphp/pest-plugin-laravel": "^4.1.0",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan": "^2.1.40",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    }
}
