{
  "name": "@john-it.com/bc-ui-runtime",
  "version": "1.6.4",
  "description": "Shared runtime build for BlueCloud ESM module registration.",
  "documentation": {
    "purpose": "Describe the bc-ui-runtime frontend build configuration for module consumers.",
    "role": "Defines the Vite-based scripts, typecheck workflow, and dependencies used to build and publish the shared runtime with a curated npm file list."
  },
  "types": "src/Resources/js/types/index.d.ts",
  "module": "src/Resources/js/runtime/index.ts",
  "exports": {
    ".": {
      "types": "./src/Resources/js/types/index.d.ts",
      "import": "./src/Resources/js/runtime/index.ts"
    },
    "./inertia": {
      "types": "./src/Resources/js/types/inertia.d.ts",
      "import": "./src/Resources/js/runtime/inertia.ts"
    },
    "./blade": {
      "import": "./src/Resources/js/runtime/blade.ts"
    },
    "./build/vite.shared.mjs": "./build/vite.shared.mjs",
    "./build/tailwind.preset.cjs": "./build/tailwind.preset.cjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "build",
    "src/Console",
    "src/Resources/dist",
    "src/Resources/js",
    "src/Runtime",
    "src/Support",
    "composer.json",
    "tsconfig.json",
    "vite.config.mjs"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "watch": "vite build --watch",
    "build": "vite build",
    "production": "vite build",
    "typecheck": "vue-tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/john-it-com/bc-ui-runtime"
  },
  "author": "",
  "license": "proprietary",
  "devDependencies": {
    "@inertiajs/vue3": "^1.1.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/compiler-sfc": "^3.1.2",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.5.0",
    "typescript": "^5.4.5",
    "vite": "^8.0.16",
    "vue": "^3.1.0",
    "vue-i18n": "^10.0.0",
    "vue-tsc": "^2.0.28",
    "ziggy-js": "^2.6.0"
  }
}
